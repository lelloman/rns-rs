#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
# Separate target directory prevents replacing an ordinary timing executable.
exec cargo run --locked --release -p rns-bench --features allocation-profiler \
  --target-dir "$repo_root/target/allocation-profiler" -- allocations "$@"
