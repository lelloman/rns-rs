FROM rust:1.96.0-bookworm AS builder
WORKDIR /build
ARG RNS_SERVER_FEATURES=rns-hooks-wasm
# Must match tests/docker/Dockerfile so the shared target cache reuses the
# dependencies that image already compiled (see the comments there).
ARG CARGO_BUILD_JOBS=default
ARG CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16
ENV CARGO_BUILD_JOBS=$CARGO_BUILD_JOBS \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=$CARGO_PROFILE_RELEASE_CODEGEN_UNITS \
    RUST_MIN_STACK=67108864
RUN for feature in $RNS_SERVER_FEATURES; do \
      case "$feature" in rns-hooks-wasm) rustup target add wasm32-unknown-unknown; exit 0 ;; esac; \
    done
# Without a .git the build scripts' rerun-if-changed inputs are missing and
# every workspace crate recompiles on each build; see tests/docker/Dockerfile.
RUN mkdir -p .git/refs && touch -d @0 .git/HEAD .git/refs
COPY Cargo.toml Cargo.lock ./
COPY build build
COPY rns-crypto rns-crypto
COPY rns-core rns-core
COPY rns-net rns-net
COPY rns-cli rns-cli
COPY rns-ctl rns-ctl
COPY rns-git rns-git
COPY rns-hooks rns-hooks
COPY rns-stats-hook rns-stats-hook
COPY rns-sentinel-hook rns-sentinel-hook
COPY rns-server rns-server
COPY rns-tun rns-tun
COPY rns-tun-android rns-tun-android
COPY tools/rns-bench tools/rns-bench
# Share the registry and target caches with tests/docker/Dockerfile so a
# rerun only relinks rns-server instead of rebuilding every dependency.
RUN --mount=type=cache,id=rns-docker-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=rns-docker-target,target=/build/target \
    cargo build --release --bin rns-server --features "$RNS_SERVER_FEATURES" \
    && mkdir -p /out && cp /build/target/release/rns-server /out/

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl sqlite3 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/rns-server /usr/local/bin/rns-server
RUN mkdir -p /etc/rns /data
EXPOSE 8080
HEALTHCHECK --interval=2s --timeout=2s --retries=30 \
  CMD curl -sf http://localhost:8080/health || exit 1
CMD ["sh", "-c", "cp /etc/rns/config /data/config && exec rns-server start --config /data --disable-auth --http-host 0.0.0.0 --http-port 8080"]
