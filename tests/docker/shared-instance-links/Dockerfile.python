# Python Reticulum node for the shared-instance-links E2E test (issue #183).
FROM python:3.12-slim
ARG RNS_VERSION=1.5.7
RUN pip install --no-cache-dir "rns==${RNS_VERSION}"
COPY python/rns_e2e_control.py /usr/local/bin/rns_e2e_control.py
COPY entrypoint-python.sh /entrypoint-python.sh
ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["sh", "/entrypoint-python.sh"]
